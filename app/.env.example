# ツールアプリの環境変数。ローカルでは cp .env.example .env.local

# ツールのテーブルを置く database(okiba_tools)。ツールアプリ用のユーザーは tools にだけ権限を持つ
DATABASE_URL=mysql://okiba_app:okiba_app@127.0.0.1:3310/okiba_tools

# 認証: dev(x-okiba-dev-user ヘッダーか OKIBA_DEV_USER をそのまま使う) | alb(x-amzn-oidc-data を検証する)
OKIBA_AUTH_MODE=dev
OKIBA_DEV_USER=dev@example.com
# alb のときに必要。ALB の公開鍵の取得先になる
# AWS_REGION=ap-northeast-1
# 指定すると、このドメイン以外のメールアドレスを拒否する
# OKIBA_ALLOWED_DOMAIN=example.com

# 認証情報の置き場: local(JSON ファイル) | aws(SSM Parameter Store)
OKIBA_MODE=local
# local のときのファイル。省略時はリポジトリのルートの .okiba/secrets.json
# OKIBA_LOCAL_SECRETS_FILE=/path/to/.okiba/secrets.json
# aws のときのパスの接頭語。/okiba/tools/<name>/<KEY> になる
# OKIBA_SSM_PREFIX=/okiba

# CP の URL(共通ヘッダーの「一覧に戻る」と / のリダイレクト先)
OKIBA_CP_URL=http://localhost:3000
