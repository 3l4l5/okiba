# ---- 共通 ----
# local: AWS を使わず、ツールアプリのディレクトリに直接書く / aws: 本番
OKIBA_MODE=local
# dev: x-okiba-dev-user ヘッダーか OKIBA_DEV_USER を利用者にする / alb: ALB の x-amzn-oidc-data を検証する
OKIBA_AUTH_MODE=dev
OKIBA_DEV_USER=dev@example.com
# 指定すると、このドメイン以外のメールアドレスを拒否する
# OKIBA_ALLOWED_DOMAIN=example.com
# 管理者(カンマ区切り)
OKIBA_ADMINS=dev@example.com
# cp / worker。worker のときだけ POST /api/internal/tick に応答する
OKIBA_ROLE=cp

PLATFORM_DATABASE_URL=mysql://okiba_cp:okiba_cp@127.0.0.1:3310/okiba_platform
TOOLS_DATABASE_URL=mysql://okiba_cp:okiba_cp@127.0.0.1:3310/okiba_tools

# 公開 URL(プロンプトと一覧のリンクに使う)
OKIBA_CP_URL=http://localhost:3000
OKIBA_TOOLS_URL=http://localhost:3001

# 1 人あたりのツール数、Upload Token の有効時間、停止から完全削除までの日数
OKIBA_MAX_TOOLS_PER_USER=10
OKIBA_TOKEN_TTL_HOURS=24
OKIBA_DELETE_GRACE_DAYS=30

# ---- local モード ----
# リポジトリのルート(既定: cp/ の 1 つ上)。app/app/tools/<name>/ に書く
# OKIBA_REPO_ROOT=/path/to/okiba
# ひな形の場所(既定: <repo>/templates)
# OKIBA_TEMPLATES_DIR=/path/to/okiba/templates
# 認証情報を置く JSON(既定: <repo>/.okiba/secrets.json)。ツールアプリにも同じ値を設定する
# OKIBA_LOCAL_SECRETS_FILE=/path/to/okiba/.okiba/secrets.json

# ---- aws モード ----
# ツールのコードは CP の DB(releases.payload)が正本。ビルドのたびに全ツールを zip にして S3 に置き、
# CodeBuild が基盤のコード(GitHub、読み取り専用、OKIBA_APP_REF の時点)に重ねてイメージを作る。
# AWS_REGION=ap-northeast-1
# 基盤のコードの git ref(タグかコミット推奨。変えると調整ループが再ビルドする。main のままなら「再ビルド」ボタンで)
# OKIBA_APP_REF=v0.1.0
# OKIBA_S3_BUCKET=okiba-artifacts
# OKIBA_CODEBUILD_PROJECT=okiba-app-build
# OKIBA_ECR_REPO_URI=123456789012.dkr.ecr.ap-northeast-1.amazonaws.com/okiba-app
# OKIBA_APP_LAMBDA_FUNCTION=okiba-app
# OKIBA_APP_LOG_GROUP=/aws/lambda/okiba-app
# Parameter Store の接頭語。ツールの認証情報は <prefix>/tools/<name>/<KEY>
# OKIBA_SSM_PREFIX=/okiba
